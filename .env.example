# Clínica Dental Eugenia — copia Cloud (supabase online)
# Base de datos: Supabase Cloud, proyecto wkygtnoiecafslvqaxff (eu-west-1).
# Ya NO hay stack Docker local de Supabase en esta copia: sin docker-compose,
# sin volúmenes locales, sin claves locales. La API lee este archivo (ver
# apps/api/src/config/index.ts: el .env de la raíz prevalece).
#
# COMPLETAR: copia las dos claves desde supabase.com → Project Settings → API
# (botón Connect NO, es para la cadena de conexión). Sustituye los valores
# PEGA_AQUI_... por las claves reales. No compartas la SECRET por chat.

# URL pública del proyecto Cloud (no es secreta)
SUPABASE_URL=https://wkygtnoiecafslvqaxff.supabase.co

# Clave publishable (anon) — se usa en cliente; la lee la API como anonKey
SUPABASE_PUBLISHABLE_KEY=PEGA_AQUI_LA_CLAVE_PUBLISHABLE
ANON_KEY=PEGA_AQUI_LA_CLAVE_PUBLISHABLE

# Clave secret (service_role) — SOLO servidor, nunca en código de cliente
SUPABASE_SECRET_KEY=PEGA_AQUI_LA_CLAVE_SECRET
SERVICE_ROLE_KEY=PEGA_AQUI_LA_CLAVE_SECRET

# API local
API_PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# WAWP y el superusuario del CRM NO van aquí: siguen en apps/api/.env
# (WAWP_ACCESS_TOKEN, WAWP_INSTANCE_ID, WAWP_WEBHOOK_SECRET, SUPER_USER, SUPER_PASS).

SUPER_USER=admin
SUPER_PASS=admin
