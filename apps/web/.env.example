# URL base de la API (debe terminar en /api/v1).
# En Render se pone como variable de entorno del sitio estático y exige
# reconstruir la web para que tenga efecto (Vite la incrusta al compilar).
# Si se deja vacío o no se define, la web usa la ruta relativa /api/v1
# (mismo origen: es lo que hace que Vercel siga funcionando con su rewrite).
VITE_API_BASE_URL=https://TU-API.onrender.com/api/v1
